# format-bench — API keys. Copy to .env and fill in only what you need. .env is gitignored.
#
# You do NOT need any of these to evaluate your own model. The primary path is:
#   format-bench run --base-url http://localhost:8000/v1 --api-key sk-... -m my-model
# which reads --api-key (or $FORMAT_BENCH_API_KEY) and ignores everything below.
FORMAT_BENCH_API_KEY=

# ── Providers used to build the public leaderboard (each has a free tier) ─────
NVIDIA_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENCODE_API_KEY=
ZENMUX_API_KEY=
KILO_API_KEY=
TOKENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
HF_TOKEN=

# ── Other gateways wired in providers.local.json ─────────────────────────────
CONCENTRATE_API_KEY=
ORCAROUTER_API_KEY=
REQUESTY_API_KEY=
CHUTES_API_KEY=
DEEPSEEK_API_KEY=
FIREWORKS_API_KEY=
ONEHOP_API_KEY=
OPENMODEL_API_KEY=
XIAOMI_API_KEY=
ZAI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Local llama-server (providers.local.json → "llama", port 8091) needs no key.
